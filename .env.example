# =============================================================
# TRUSTGATE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or real credentials to version control.
# =============================================================

# =============================================================
# [PUBLIC] CLIENT-ACCESSIBLE VARIABLES (Vite Frontend)
# Safe to expose in the browser bundle. Never place secrets here.
# =============================================================

# InsForge / Supabase BaaS API Base URL
VITE_INSFORGE_URL=https://your-project.region.insforge.app

# InsForge / Supabase Anonymous (Public) Client Key
VITE_INSFORGE_ANON_KEY=your-insforge-anon-key-here

# Local or Production Frontend Origin URL
VITE_APP_URL=http://localhost:5173

# Optional: Dedicated Python / AI Microservice Base URL
VITE_AI_SERVICE_URL=http://localhost:8000

# Optional: Demo Persona Password (Local Development Only)
VITE_DEMO_PASSWORD=

# =============================================================
# [SERVER_ONLY] BACKEND & MICROSERVICE CONFIGURATION
# Accessible ONLY to server processes / Python microservice / edge functions.
# NEVER expose to browser JavaScript or client bundles.
# =============================================================

# AI Inference Service Host & Port
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_ENGINE_WORKERS=4

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=20

# Model Paths & Offline Cache Directories
ONNX_MODELS_DIR=./ai/checkpoints
DATASETS_DIR=./ai/datasets

# =============================================================
# [SECRET] CONFIDENTIAL CREDENTIALS & SIGNING KEYS
# RESTRICTED: Requires secure key management (KMS / Vault / Secret Manager).
# ABSOLUTELY NEVER commit, log, or expose to frontend bundles.
# =============================================================

# Database Connection String (Direct PostgreSQL access for migrations/backend)
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres

# Backend Admin / Service-Role Token (Full database bypass for server operations)
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key-here

# Blockchain Evidence Anchor Signing Key (Private key for digital signatures)
BLOCKCHAIN_SIGNING_PRIVATE_KEY=your-blockchain-private-key-here

# JWT Signature Verification Secret
JWT_SECRET=your-jwt-secret-here
