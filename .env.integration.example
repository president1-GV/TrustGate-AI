# =============================================================
# TrustGate AI Billion — Integration Test Environment
# Copy to .env.integration (gitignored) and fill in values.
# NEVER commit actual credentials.
# =============================================================

# InsForge project URL (from .insforge/project.json oss_host)
INTEGRATION_BASE_URL=https://your-appkey.us-east.insforge.app

# InsForge anonymous key (public key — safe to use in client code but not in source)
INTEGRATION_ANON_KEY=anon_your_key_here

# Demo account credentials — Admin role
INTEGRATION_ADMIN_EMAIL=admin@your-project.ai
INTEGRATION_ADMIN_PASSWORD=your-secure-password-here

# Demo account credentials — Supervisor role
INTEGRATION_SUP_EMAIL=supervisor@your-project.ai
INTEGRATION_SUP_PASSWORD=your-secure-password-here

# Demo account credentials — Officer role
INTEGRATION_OFFICER_EMAIL=officer@your-project.ai
INTEGRATION_OFFICER_PASSWORD=your-secure-password-here
